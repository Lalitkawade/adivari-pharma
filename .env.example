# Supabase Production & Local Configuration
# Copy this file to .env locally and fill with your own Supabase project details.
# In production (e.g. Vercel), add these variables in Project Settings > Environment Variables.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
